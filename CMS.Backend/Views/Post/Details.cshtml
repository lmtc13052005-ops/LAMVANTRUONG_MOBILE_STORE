@model CMS.Data.Entities.Post
@{
    ViewData["Title"] = Model.Title;
    ViewData["ActiveMenu"] = "post";
    Layout = "_AdminLayout";
}

<div class="relative flex flex-col min-w-0 break-words bg-white w-full mb-6 shadow-lg rounded">
    <div class="px-6 py-6">
        <a asp-action="Index" class="text-blueGray-500 text-xs font-semibold mb-4 inline-block"><i class="fas fa-arrow-left mr-1"></i> Quay lại danh sách</a>
        <div class="mt-2">
            <span class="text-xs font-semibold inline-block py-1 px-2 rounded text-lightBlue-600 bg-lightBlue-200" style="background-color:#e0f2fe">@Model.Category?.Name</span>
        </div>
        <h1 class="text-2xl font-bold text-blueGray-700 mt-2">@Model.Title</h1>
        <p class="text-blueGray-400 text-sm">Ngày đăng: @Model.CreatedDate.ToString("dd/MM/yyyy")</p>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="rounded my-4 max-h-96" alt="@Model.Title" />
        }

        <hr class="my-4" />
        @* Nội dung HTML do CKEditor sinh ra (tiêu chí #44 sẽ dùng tương tự ở Frontend) *@
        <div class="prose max-w-none text-blueGray-600 leading-relaxed">
            @Html.Raw(Model.Content)
        </div>
    </div>
</div>
