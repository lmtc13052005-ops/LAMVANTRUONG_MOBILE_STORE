@model IEnumerable<CMS.Data.Entities.Post>
@{
    ViewData["Title"] = "Trang chủ quản trị";
}

<div class="text-center mt-4 mb-4">
    <h1 class="display-5 text-primary">📱 TruongCMS.MobileStore — Khu quản trị</h1>
    <p class="lead text-muted">Website Kinh Doanh Điện Thoại, Laptop &amp; Đồ Điện Tử</p>
</div>

<div class="container mt-5">
    <h2 class="text-center mb-4 text-danger">TIN TỨC MỚI NHẤT</h2>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100">
                    <img src="@item.ImageUrl" class="card-img-top" alt="Thumbnail" style="height:180px;object-fit:cover" />
                    <div class="card-body">
                        <span class="badge bg-primary mb-2">@item.Category?.Name</span>
                        <h5 class="card-title">@item.Title</h5>
                        <a asp-controller="Post" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Đọc tiếp</a>
                    </div>
                    <div class="card-footer text-muted small">
                        Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                    </div>
                </div>
            </div>
        }
    </div>
</div>
