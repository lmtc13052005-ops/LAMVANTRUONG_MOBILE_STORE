@model IEnumerable<CMS.Data.Entities.Customer>
@{
    ViewData["Title"] = "Khách hàng";
    ViewData["ActiveMenu"] = "customer";
    Layout = "_AdminLayout";
}

<div class="relative flex flex-col min-w-0 break-words bg-white w-full mb-6 shadow-lg rounded">
    <div class="rounded-t mb-0 px-4 py-3 border-0">
        <h3 class="font-semibold text-base text-blueGray-700">Danh sách khách hàng</h3>
    </div>
    <div class="block w-full overflow-x-auto">
        <table class="items-center w-full bg-transparent border-collapse">
            <thead>
                <tr>
                    <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">ID</th>
                    <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">Họ tên</th>
                    <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">Email</th>
                    <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">Điện thoại</th>
                    <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">Địa chỉ</th>
                    <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-blueGray-50">
                        <td class="border-t border-blueGray-100 px-6 py-3 text-xs">@item.Id</td>
                        <td class="border-t border-blueGray-100 px-6 py-3 text-xs font-bold text-blueGray-600">@item.FullName</td>
                        <td class="border-t border-blueGray-100 px-6 py-3 text-xs">@item.Email</td>
                        <td class="border-t border-blueGray-100 px-6 py-3 text-xs">@item.Phone</td>
                        <td class="border-t border-blueGray-100 px-6 py-3 text-xs text-blueGray-500">@item.Address</td>
                        <td class="border-t border-blueGray-100 px-6 py-3 text-xs whitespace-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="text-lightBlue-600 font-semibold mr-3"><i class="fas fa-pen"></i> Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="text-red-500 font-semibold"
                               onclick="return confirm('Xóa khách hàng này?')"><i class="fas fa-trash"></i> Xóa</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="border-t border-blueGray-100 px-6 py-6 text-center text-blueGray-400 text-sm">Chưa có khách hàng nào (khách đăng ký ở Frontend - Buổi 10).</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
