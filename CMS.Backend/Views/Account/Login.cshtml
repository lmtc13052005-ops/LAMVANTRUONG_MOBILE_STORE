@{
    ViewData["Title"] = "Đăng nhập quản trị";
    Layout = null; // Trang Login độc lập (#19)
    var error = ViewBag.Error as string;
    var returnUrl = ViewBag.ReturnUrl as string;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
</head>
<body class="text-slate-700 antialiased" style="background-color:#1e293b">
    <div class="container mx-auto px-4 h-full">
        <div class="flex content-center items-center justify-center h-screen">
            <div class="w-full lg:w-4/12 px-4">
                <div class="relative flex flex-col min-w-0 break-words w-full mb-6 shadow-lg rounded-lg bg-slate-200 border-0">
                    <div class="rounded-t mb-0 px-6 py-6">
                        <div class="text-center mb-3">
                            <h6 class="text-slate-500 text-sm font-bold">📱 TruongCMS.MobileStore — Quản trị</h6>
                        </div>
                        <hr class="mt-6 border-b-1 border-slate-300" />
                    </div>
                    <div class="flex-auto px-4 lg:px-10 py-10 pt-0">
                        @if (!string.IsNullOrEmpty(error))
                        {
                            <div class="text-white text-sm rounded px-3 py-2 mb-4" style="background-color:#ef4444">@error</div>
                        }
                        <form asp-action="Login" method="post">
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <div class="relative w-full mb-3">
                                <label class="block uppercase text-slate-600 text-xs font-bold mb-2">Tên đăng nhập</label>
                                <input name="username" type="text" class="border-0 px-3 py-3 text-slate-600 bg-white rounded text-sm shadow w-full" placeholder="admin" required />
                            </div>
                            <div class="relative w-full mb-3">
                                <label class="block uppercase text-slate-600 text-xs font-bold mb-2">Mật khẩu</label>
                                <input name="password" type="password" class="border-0 px-3 py-3 text-slate-600 bg-white rounded text-sm shadow w-full" placeholder="Mật khẩu" required />
                            </div>
                            <div class="text-center mt-6">
                                <button type="submit" class="text-white font-bold uppercase text-sm px-6 py-3 rounded shadow hover:shadow-lg w-full" style="background-color:#1e293b">
                                    Đăng nhập
                                </button>
                            </div>
                        </form>
<p class="text-center text-slate-400 text-xs mt-4">Demo: admin / admin123 &nbsp;·&nbsp; editor / editor123</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
