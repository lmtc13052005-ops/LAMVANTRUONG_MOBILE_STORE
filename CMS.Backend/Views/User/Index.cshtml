@model IEnumerable<CMS.Data.Entities.User>
@{
    ViewData["Title"] = "Tài khoản quản trị";
    ViewData["ActiveMenu"] = "user";
    Layout = "_AdminLayout";
}

<div class="relative flex flex-col min-w-0 break-words bg-white w-full mb-6 shadow-lg rounded">
    <div class="rounded-t mb-0 px-4 py-3 border-0">
        <div class="flex flex-wrap items-center">
            <div class="relative w-full px-4 max-w-full flex-grow flex-1">
                <h3 class="font-semibold text-base text-blueGray-700">Tài khoản quản trị nội bộ</h3>
            </div>
            <a asp-action="Create" class="text-white font-bold uppercase text-xs px-4 py-2 rounded shadow hover:shadow-md" style="background-color:#0284c7">
                <i class="fas fa-plus mr-1"></i> Thêm tài khoản
            </a>
        </div>
    </div>
    <div class="block w-full overflow-x-auto">
        <table class="items-center w-full bg-transparent border-collapse">
            <thead>
                <tr>
                    <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">ID</th>
                    <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">Tên đăng nhập</th>
                    <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">Họ tên</th>
                    <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">Vai trò</th>
                    <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-blueGray-50">
                        <td class="border-t border-blueGray-100 px-6 py-3 text-xs">@item.Id</td>
                        <td class="border-t border-blueGray-100 px-6 py-3 text-xs font-bold text-blueGray-600">@item.Username</td>
                        <td class="border-t border-blueGray-100 px-6 py-3 text-xs">@item.FullName</td>
                        <td class="border-t border-blueGray-100 px-6 py-3 text-xs">
                            <span class="text-xs font-semibold inline-block py-1 px-2 rounded @(item.Role == "Admin" ? "text-red-600 bg-red-100" : "text-emerald-600 bg-emerald-100")">@item.Role</span>
                        </td>
                        <td class="border-t border-blueGray-100 px-6 py-3 text-xs whitespace-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="text-lightBlue-600 font-semibold mr-3"><i class="fas fa-pen"></i> Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="text-red-500 font-semibold"
                               onclick="return confirm('Xóa tài khoản này?')"><i class="fas fa-trash"></i> Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
