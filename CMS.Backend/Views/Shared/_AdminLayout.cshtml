@{
    string activeMenu = ViewData["ActiveMenu"] as string ?? "";
    string fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Admin";
    string role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    string initials = fullName.Length >= 2 ? fullName.Substring(0, 2).ToUpper() : fullName.ToUpper();

    bool IsActive(string key) => key == activeMenu;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — TruongMobile Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: { 50:'#f0fdf4', 100:'#dcfce7', 500:'#22c55e', 600:'#16a34a', 700:'#15803d' },
                        blueGray: {
                            50:'#f8fafc', 100:'#f1f5f9', 200:'#e2e8f0', 300:'#cbd5e1',
                            400:'#94a3b8', 500:'#64748b', 600:'#475569', 700:'#334155', 800:'#1e293b'
                        },
                        lightBlue: { 100:'#e0f2fe', 500:'#0ea5e9', 600:'#0284c7' }
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; font-family: 'Inter', 'Segoe UI', system-ui, sans-serif; background: #f1f5f9; }
        .sidebar-link { display:flex; align-items:center; gap:10px; padding:9px 14px; border-radius:8px; font-size:13px; font-weight:500; color:#475569; text-decoration:none; transition:background .15s, color .15s; cursor:pointer; }
        .sidebar-link:hover { background:#f1f5f9; color:#1e293b; }
        .sidebar-link.active { background:#f0fdf4; color:#16a34a; font-weight:600; }
        .sidebar-link.active i { color:#16a34a; }
        .sidebar-link i { width:16px; text-align:center; color:#94a3b8; font-size:14px; }
        .sidebar-section { font-size:10.5px; font-weight:700; letter-spacing:.8px; color:#94a3b8; text-transform:uppercase; padding:6px 14px 4px; margin-top:6px; }
        ::-webkit-scrollbar { width:4px; } ::-webkit-scrollbar-track { background:transparent; } ::-webkit-scrollbar-thumb { background:#cbd5e1; border-radius:4px; }
    </style>
</head>
<body>
<div style="display:flex; min-height:100vh;">

    <!-- ===== SIDEBAR ===== -->
    <aside style="width:240px; flex-shrink:0; background:#fff; border-right:1px solid #e2e8f0; display:flex; flex-direction:column; position:fixed; top:0; bottom:0; left:0; z-index:50; overflow-y:auto;">

        <!-- Logo -->
        <div style="padding:20px 18px 16px; border-bottom:1px solid #f1f5f9;">
            <a asp-controller="Home" asp-action="Dashboard" style="display:flex; align-items:center; gap:10px; text-decoration:none;">
                <div style="width:34px; height:34px; background:#16a34a; border-radius:9px; display:flex; align-items:center; justify-content:center;">
                    <i class="fas fa-mobile-screen" style="color:#fff; font-size:16px;"></i>
                </div>
                <div>
                    <div style="font-size:15px; font-weight:800; color:#1e293b; line-height:1.1;">TruongMobile</div>
                    <div style="font-size:10px; color:#94a3b8; font-weight:500;">Admin Panel</div>
                </div>
            </a>
        </div>

        <!-- Nav -->
        <nav style="flex:1; padding:12px 10px;">
            <div class="sidebar-section">Tổng quan</div>
            <a class="sidebar-link @(IsActive("dashboard") ? "active" : "")" asp-controller="Home" asp-action="Dashboard">
                <i class="fas fa-chart-pie"></i> Bảng điều khiển
            </a>

            <div class="sidebar-section" style="margin-top:12px;">Nội dung</div>
            <a class="sidebar-link @(IsActive("categoryproduct") ? "active" : "")" asp-controller="CategoryProduct" asp-action="Index">
                <i class="fas fa-layer-group"></i> Ngành hàng
            </a>
            <a class="sidebar-link @(IsActive("product") ? "active" : "")" asp-controller="Product" asp-action="Index">
                <i class="fas fa-mobile-screen"></i> Sản phẩm
            </a>
            <a class="sidebar-link @(IsActive("category") ? "active" : "")" asp-controller="Category" asp-action="Index">
                <i class="fas fa-folder-open"></i> Danh mục bài viết
            </a>
            <a class="sidebar-link @(IsActive("post") ? "active" : "")" asp-controller="Post" asp-action="Index">
                <i class="fas fa-newspaper"></i> Bài viết
            </a>

            <div class="sidebar-section" style="margin-top:12px;">Vận hành</div>
            <a class="sidebar-link @(IsActive("order") ? "active" : "")" asp-controller="Order" asp-action="Index">
                <i class="fas fa-bag-shopping"></i> Đơn hàng
                @if (ViewBag.PendingOrders != null && (int)ViewBag.PendingOrders > 0)
                {
                    <span style="margin-left:auto; background:#ef4444; color:#fff; font-size:10px; font-weight:700; padding:1px 7px; border-radius:20px;">@ViewBag.PendingOrders</span>
                }
            </a>
            <a class="sidebar-link @(IsActive("customer") ? "active" : "")" asp-controller="Customer" asp-action="Index">
                <i class="fas fa-users"></i> Khách hàng
            </a>
            <a class="sidebar-link @(IsActive("passwordreset") ? "active" : "")" asp-controller="PasswordReset" asp-action="Index">
                <i class="fas fa-key"></i> Đặt lại mật khẩu
                @{
                    // Badge số lượng yêu cầu chờ (dùng ViewBag từ middleware hoặc tính trực tiếp)
                }
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a class="sidebar-link @(IsActive("user") ? "active" : "")" asp-controller="User" asp-action="Index">
                    <i class="fas fa-user-shield"></i> Tài khoản QT
                </a>
            }
        </nav>

        <!-- User info -->
        <div style="padding:14px 16px; border-top:1px solid #f1f5f9;">
            <div style="display:flex; align-items:center; gap:10px;">
                <div style="width:34px; height:34px; border-radius:50%; background:linear-gradient(135deg,#16a34a,#0ea5e9); display:flex; align-items:center; justify-content:center; font-size:13px; font-weight:800; color:#fff; flex-shrink:0;">
                    @initials
                </div>
                <div style="flex:1; min-width:0;">
                    <div style="font-size:13px; font-weight:600; color:#1e293b; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@fullName</div>
                    <div style="font-size:11px; color:#94a3b8;">@role</div>
                </div>
                <a asp-controller="Account" asp-action="Logout" title="Đăng xuất" style="color:#94a3b8; text-decoration:none; font-size:14px; flex-shrink:0; padding:4px;">
                    <i class="fas fa-right-from-bracket"></i>
                </a>
            </div>
        </div>
    </aside>

    <!-- ===== MAIN AREA ===== -->
    <div style="flex:1; margin-left:240px; display:flex; flex-direction:column; min-height:100vh;">

        <!-- Top bar -->
        <header style="background:#fff; border-bottom:1px solid #e2e8f0; padding:0 28px; height:58px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:40;">
            <div>
                <div style="font-size:15px; font-weight:700; color:#1e293b;">@ViewData["Title"]</div>
                <div style="font-size:11.5px; color:#94a3b8;">TruongMobile / @ViewData["Title"]</div>
            </div>
            <div style="display:flex; align-items:center; gap:12px;">
                <a href="/" target="_blank" style="font-size:12px; color:#16a34a; font-weight:600; text-decoration:none; border:1px solid #dcfce7; padding:5px 12px; border-radius:7px; background:#f0fdf4;">
                    <i class="fas fa-arrow-up-right-from-square" style="font-size:11px;"></i> Xem website
                </a>
                <div style="font-size:12.5px; color:#475569; font-weight:500;">@DateTime.Now.ToString("dd/MM/yyyy")</div>
            </div>
        </header>

        <!-- Page content -->
        <main style="flex:1; padding:24px 28px 40px;">
            @RenderSection("Stats", required: false)
            @RenderBody()
        </main>

        <footer style="padding:14px 28px; border-top:1px solid #e2e8f0; background:#fff;">
            <div style="font-size:12px; color:#94a3b8;">&copy; 2026 TruongMobile — Admin Panel</div>
        </footer>
    </div>
</div>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
