@model CMS.Data.Entities.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
    ViewData["ActiveMenu"] = "order";
    Layout = "_AdminLayout";
    string StatusText(int s) => s switch { 0 => "Chờ duyệt", 1 => "Đang giao", 2 => "Đã xong", _ => "?" };
}

<div class="flex flex-wrap">
    <div class="w-full lg:w-8/12 px-4">
        <div class="relative flex flex-col min-w-0 break-words bg-white w-full mb-6 shadow-lg rounded">
            <div class="rounded-t mb-0 px-4 py-3 border-0">
                <h3 class="font-semibold text-base text-blueGray-700">Sản phẩm trong đơn #@Model.Id</h3>
            </div>
            <div class="block w-full overflow-x-auto">
                <table class="items-center w-full bg-transparent border-collapse">
                    <thead>
                        <tr>
                            <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">Sản phẩm</th>
                            <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">Đơn giá</th>
                            <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">SL</th>
                            <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OrderDetails != null)
                        {
                            foreach (var d in Model.OrderDetails)
                            {
                                <tr class="hover:bg-blueGray-50">
                                    <td class="border-t border-blueGray-100 px-6 py-3 text-xs font-bold text-blueGray-600">@d.Product?.Name</td>
                                    <td class="border-t border-blueGray-100 px-6 py-3 text-xs">@d.UnitPrice.ToString("#,##0") ₫</td>
                                    <td class="border-t border-blueGray-100 px-6 py-3 text-xs">@d.Quantity</td>
                                    <td class="border-t border-blueGray-100 px-6 py-3 text-xs">@((d.UnitPrice * d.Quantity).ToString("#,##0")) ₫</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="w-full lg:w-4/12 px-4">
        <div class="relative flex flex-col min-w-0 break-words bg-white w-full mb-6 shadow-lg rounded">
            <div class="px-6 py-5">
                <h3 class="font-semibold text-base text-blueGray-700 mb-3">Thông tin đơn hàng</h3>
                <p class="text-sm text-blueGray-500 mb-1"><b>Khách hàng:</b> @Model.Customer?.FullName</p>
                <p class="text-sm text-blueGray-500 mb-1"><b>Email:</b> @Model.Customer?.Email</p>
                <p class="text-sm text-blueGray-500 mb-1"><b>Điện thoại:</b> @Model.Customer?.Phone</p>
                <p class="text-sm text-blueGray-500 mb-1"><b>Ngày đặt:</b> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                <p class="text-sm text-blueGray-500 mb-1"><b>Ghi chú:</b> @Model.Notes</p>
                <p class="text-lg font-bold text-blueGray-700 mt-2">Tổng: @Model.TotalAmount.ToString("#,##0") ₫</p>

                <hr class="my-3" />
                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label class="block uppercase text-blueGray-600 text-xs font-bold mb-2">Trạng thái</label>
                    <select name="status" class="border-0 px-3 py-3 text-blueGray-600 bg-white rounded text-sm shadow w-full mb-3">
                        @for (int s = 0; s <= 2; s++)
                        {
                            if (s == Model.Status)
                            {
                                <option value="@s" selected>@StatusText(s)</option>
                            }
                            else
                            {
                                <option value="@s">@StatusText(s)</option>
                            }
                        }
                    </select>
                    <button type="submit" class="text-white font-bold uppercase text-xs px-4 py-2 rounded shadow w-full" style="background-color:#0284c7">Cập nhật trạng thái</button>
                </form>
                <a asp-action="Index" class="text-blueGray-500 text-xs font-semibold mt-3 inline-block"><i class="fas fa-arrow-left mr-1"></i> Quay lại danh sách</a>
            </div>
        </div>
    </div>
</div>
