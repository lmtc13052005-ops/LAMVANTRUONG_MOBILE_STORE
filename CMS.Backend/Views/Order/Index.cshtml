@model IEnumerable<CMS.Data.Entities.Order>
@{
    ViewData["Title"] = "Đơn hàng";
    ViewData["ActiveMenu"] = "order";
    Layout = "_AdminLayout";
    string StatusText(int s) => s switch { 0 => "Chờ duyệt", 1 => "Đang giao", 2 => "Đã xong", _ => "?" };
    string StatusClass(int s) => s switch { 0 => "text-orange-600 bg-orange-100", 1 => "text-lightBlue-600 bg-lightBlue-100", 2 => "text-emerald-600 bg-emerald-100", _ => "" };
}

<div class="relative flex flex-col min-w-0 break-words bg-white w-full mb-6 shadow-lg rounded">
    <div class="rounded-t mb-0 px-4 py-3 border-0">
        <h3 class="font-semibold text-base text-blueGray-700">Danh sách đơn hàng</h3>
    </div>
    <div class="block w-full overflow-x-auto">
        <table class="items-center w-full bg-transparent border-collapse">
            <thead>
                <tr>
                    <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">Mã ĐH</th>
                    <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">Khách hàng</th>
                    <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">Ngày đặt</th>
                    <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">Tổng tiền</th>
                    <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">Trạng thái</th>
                    <th class="px-6 py-3 text-xs uppercase font-semibold text-left bg-blueGray-50 text-blueGray-500 border-b border-blueGray-100">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-blueGray-50">
                        <td class="border-t border-blueGray-100 px-6 py-3 text-xs font-bold text-blueGray-600">#@item.Id</td>
                        <td class="border-t border-blueGray-100 px-6 py-3 text-xs">@item.Customer?.FullName</td>
                        <td class="border-t border-blueGray-100 px-6 py-3 text-xs">@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="border-t border-blueGray-100 px-6 py-3 text-xs">@item.TotalAmount.ToString("#,##0") ₫</td>
                        <td class="border-t border-blueGray-100 px-6 py-3 text-xs">
                            <span class="text-xs font-semibold inline-block py-1 px-2 rounded @StatusClass(item.Status)">@StatusText(item.Status)</span>
                        </td>
                        <td class="border-t border-blueGray-100 px-6 py-3 text-xs whitespace-nowrap">
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-lightBlue-600 font-semibold"><i class="fas fa-eye"></i> Chi tiết</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="border-t border-blueGray-100 px-6 py-6 text-center text-blueGray-400 text-sm">Chưa có đơn hàng nào (đơn được tạo từ Frontend - Buổi 11).</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
