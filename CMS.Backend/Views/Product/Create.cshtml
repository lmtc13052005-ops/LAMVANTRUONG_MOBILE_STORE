@model CMS.Data.Entities.Product
@{
    ViewData["Title"] = "Thêm sản phẩm";
    ViewData["ActiveMenu"] = "product";
    Layout = "_AdminLayout";
    var categories = ViewBag.CategoryProducts as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div class="relative flex flex-col min-w-0 break-words w-full mb-6 shadow-lg rounded-lg bg-blueGray-100 border-0">
    <div class="rounded-t bg-white mb-0 px-6 py-6">
        <h6 class="text-blueGray-700 text-xl font-bold">Thêm sản phẩm</h6>
    </div>
    <div class="flex-auto px-4 lg:px-10 py-10 pt-0 bg-white">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-3"></div>
            <div class="relative w-full mb-3">
                <label class="block uppercase text-blueGray-600 text-xs font-bold mb-2">Tên sản phẩm</label>
                <input asp-for="Name" class="border-0 px-3 py-3 text-blueGray-600 bg-white rounded text-sm shadow w-full" />
                <span asp-validation-for="Name" class="text-red-500 text-xs"></span>
            </div>
            <div class="flex flex-wrap">
                <div class="w-full lg:w-6/12 lg:pr-2 mb-3">
                    <label class="block uppercase text-blueGray-600 text-xs font-bold mb-2">Giá (₫)</label>
                    <input asp-for="Price" type="number" step="1000" class="border-0 px-3 py-3 text-blueGray-600 bg-white rounded text-sm shadow w-full" />
                </div>
                <div class="w-full lg:w-6/12 lg:pl-2 mb-3">
                    <label class="block uppercase text-blueGray-600 text-xs font-bold mb-2">Tồn kho</label>
                    <input asp-for="StockQuantity" type="number" class="border-0 px-3 py-3 text-blueGray-600 bg-white rounded text-sm shadow w-full" />
                </div>
            </div>
            <div class="relative w-full mb-3">
                <label class="block uppercase text-blueGray-600 text-xs font-bold mb-2">Ngành hàng</label>
                <select asp-for="CategoryProductId" asp-items="categories" class="border-0 px-3 py-3 text-blueGray-600 bg-white rounded text-sm shadow w-full"></select>
            </div>
            <div class="relative w-full mb-3">
                <label class="inline-flex items-center text-blueGray-600 text-sm font-bold">
                    <input asp-for="IsHot" type="checkbox" class="form-checkbox mr-2" /> Đánh dấu sản phẩm HOT / bán chạy
                </label>
            </div>
            <div class="relative w-full mb-3">
                <label class="block uppercase text-blueGray-600 text-xs font-bold mb-2">Ảnh đại diện</label>
                <input asp-for="ImageUrl" id="ImageUrl" class="border-0 px-3 py-3 text-blueGray-600 bg-white rounded text-sm shadow w-full mb-2" />
                <input type="file" id="imageFile" accept="image/*" class="text-xs" />
                <span id="uploadStatus" class="text-xs text-blueGray-500 ml-2"></span>
            </div>
            <div class="relative w-full mb-3">
                <label class="block uppercase text-blueGray-600 text-xs font-bold mb-2">Mô tả chi tiết</label>
                <textarea asp-for="Description" class="js-ckeditor"></textarea>
            </div>
            <div class="mt-6">
                <button type="submit" class="text-white font-bold uppercase text-xs px-5 py-3 rounded shadow hover:shadow-md mr-2" style="background-color:#0284c7">Lưu</button>
                <a asp-action="Index" class="text-blueGray-600 font-bold uppercase text-xs px-5 py-3">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_CKEditorScripts" />
    <partial name="_ImageUploadScript" />
}
